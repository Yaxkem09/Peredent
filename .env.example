# Aquí van todas las variables de entorno necesarias para la aplicación como connection strings, JWT secret, email settings, URLs, etc.
# Copiar a backend/.env (gitignored) y reemplazar los valores de ejemplo. Nunca commitear valores reales.

# ---------------------------------------------------------------------------
# Recordatorios de citas por WhatsApp (WhatsApp Cloud API de Meta)
# ---------------------------------------------------------------------------
# false o sin definir: la app arranca sin las demás variables de WhatsApp.
# true: WHATSAPP_PHONE_NUMBER_ID y WHATSAPP_TOKEN pasan a ser obligatorias.
WHATSAPP_ENABLED=false
# Opcional (default v25.0).
WHATSAPP_API_VERSION=v25.0
# Phone Number ID del panel de WhatsApp en Meta for Developers (no es el número de teléfono).
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Token de acceso de la Cloud API (en producción, token permanente de un System User).
WHATSAPP_TOKEN=EAAG-token-de-ejemplo-no-real
# Opcionales (defaults recordatorio_cita / es).
WHATSAPP_TEMPLATE_NAME=recordatorio_cita
WHATSAPP_TEMPLATE_LANGUAGE=es

# Webhook de respuestas de los pacientes (POST/GET /api/whatsapp/webhook).
# No impiden arrancar la app; si faltan, el webhook rechaza todo y lo registra en el log.
# App Secret de la app de Meta (Meta for Developers > App settings > Basic): valida la firma X-Hub-Signature-256.
WHATSAPP_APP_SECRET=app-secret-de-ejemplo-no-real
# Texto secreto que se escribe también en Meta (WhatsApp > Configuration > Webhook > Verify token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=verify-token-de-ejemplo-cambiar

# Datos de la clínica para los mensajes de vuelta al paciente (respuesta a los
# botones del recordatorio). Opcionales: sin ellas se usan estos mismos valores.
CLINICA_TELEFONO=7755-1080
# Usar \n para los saltos de línea.
CLINICA_HORARIO="Lunes a viernes: 8:00 AM a 1:00 PM y 2:00 PM a 6:00 PM\nSábados: 8:00 AM a 1:00 PM"

# API key que GitHub Actions envía al endpoint de recordatorios.
REMINDERS_API_KEY=clave-de-ejemplo-cambiar
