# =========================================================================
# Variables de entorno del backend (PEREDENT)
# =========================================================================
# Copiar este archivo a backend/.env (ese archivo SÍ está en .gitignore) y
# completar con los valores reales. El backend lo lee al arrancar (DotNetEnv);
# en la nube las variables las inyecta la plataforma y no hace falta el archivo.
# Los valores de abajo son de ejemplo: no son secretos reales.

# --- Base de datos (SQL Server) ---
DB_HOST=localhost,1433
DB_NAME=Peredent
# Si DB_USER queda vacío, se conecta con autenticación de Windows (SSMS/LocalDB).
DB_USER=sa
DB_PASSWORD=clave-de-ejemplo

# --- JWT ---
# Obligatorio: al menos 32 bytes (256 bits) para HMACSHA256.
JWT_SECRET=secreto-de-ejemplo-con-mas-de-32-bytes
# Opcional; por defecto 480 minutos (8 horas = un turno clínico).
JWT_EXPIRATION_MINUTES=480

# --- CORS ---
# Opcional: orígenes permitidos separados por coma. Si no está, se usa
# Cors:AllowedOrigins de appsettings.json.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Correo saliente (SCRUM-232) ---
# Sin SMTP_HOST o sin SMTP_FROM el backend NO intenta enviar: en Development
# escribe el enlace del correo en la consola del backend y en cualquier otro
# entorno solo registra "SMTP no configurado" (sin el enlace). El flujo de
# recuperación nunca falla por esto.
# Local con Mailpit: host localhost, puerto 1025, security none, sin usuario.
# Producción (Somee): puerto 25 o 26, security none, con usuario y contraseña
# SMTP y SMTP_FROM igual al usuario SMTP.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@peredent.local
# none | starttls | ssl
SMTP_SECURITY=none

# --- Enlaces del frontend (SCRUM-232) ---
# Base para armar el enlace del correo:
#   {FRONTEND_BASE_URL}/restablecer-contrasena?token=...
FRONTEND_BASE_URL=http://localhost:5173
