<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Peredent.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peredent.Api.csproj" />
  </ItemGroup>

  <!--
    UnitTests/Services/AuthServiceTests.cs y CitaServiceTests.cs todavia son
    descripciones en texto plano (placeholder), no C# real, se excluyen del
    build por la misma razon que Peredent.Api.csproj excluye Services/ y
    Repositories/. Se re-habilitan cuando esos modulos existan de verdad.
  -->
  <ItemGroup>
    <Compile Remove="UnitTests/Services/AuthServiceTests.cs" />
    <Compile Remove="UnitTests/Services/CitaServiceTests.cs" />
  </ItemGroup>

</Project>
